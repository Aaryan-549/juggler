  { "name": "a context picks its own translation", "template": "Open", "context": "verb", "locale": "fr", "catalog": { "Open": "Ouvert", "verb\u0004Open": "Ouvrir" }, "expected": "Ouvrir" },
  { "name": "no context picks the plain one", "template": "Open", "locale": "fr", "catalog": { "Open": "Ouvert", "verb\u0004Open": "Ouvrir" }, "expected": "Ouvert" },
  { "name": "a context with no translation falls back to English", "template": "Open", "context": "verb", "locale": "fr", "catalog": { "Open": "Ouvert" }, "expected": "Open" },
