  { "name": "plural zero is other in English", "template": "{n, plural, one {# file} other {# files}}", "params": { "n": 0 }, "expected": "0 files" },
  { "name": "plural negative one", "template": "{n, plural, one {# file} other {# files}}", "params": { "n": -1 }, "expected": "-1 file" },
  { "name": "plural fraction is other", "template": "{n, plural, one {# file} other {# files}}", "params": { "n": 1.5 }, "expected": "1.5 files" },
  { "name": "pound is grouped", "template": "{n, plural, one {# file} other {# files}}", "params": { "n": 1234567 }, "expected": "1,234,567 files" },
