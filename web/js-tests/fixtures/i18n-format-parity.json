  { "name": "no params at all", "template": "Hello, {name}", "expected": "Hello, {name}" },
  { "name": "a number placeholder is not grouped", "template": "{n} items", "params": { "n": 1234 }, "expected": "1234 items" },
  { "name": "a fractional number placeholder", "template": "{x}", "params": { "x": 1.5 }, "expected": "1.5" },
  { "name": "a huge number uses an exponent", "template": "{x}", "params": { "x": 1e21 }, "expected": "1e+21" },
  { "name": "a small number stays fixed", "template": "{x}", "params": { "x": 0.000001 }, "expected": "0.000001" },
  { "name": "a tiny number uses an exponent", "template": "{x}", "params": { "x": 1e-7 }, "expected": "1e-7" },
  { "name": "a shortest round-trip float", "template": "{x}", "params": { "x": 0.30000000000000004 }, "expected": "0.30000000000000004" },
  { "name": "booleans and null", "template": "{a} {b} {c}", "params": { "a": true, "b": false, "c": null }, "expected": "true false null" },
